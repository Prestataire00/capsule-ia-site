---
import Layout from '../layouts/Layout.astro';

// Les demandes sont envoyées au formulaire Formspree « Devis Capsule IA ».
// Pour utiliser un autre service, définir PUBLIC_FORM_ENDPOINT (voir .env.example).
const endpoint = '/';
const email = 'contact@capsuleia.fr';

// Liste déroulante des formations, par famille. `v` est le libellé reçu dans la demande.
const catalogue = [
  { groupe: 'Bootcamps & IA Expert · 16 heures', items: [
    { v: 'Bootcamp Claude de A à Z', cle: 'bootcamp-claude' },
    { v: 'Bootcamp ChatGPT de A à Z', cle: 'bootcamp-chatgpt' },
    { v: 'Bootcamp Copilot de A à Z', cle: 'bootcamp-copilot' },
    { v: 'Cerveau IA : concevoir le cerveau IA de votre entreprise', cle: 'cerveau-ia' },
  ] },
  { groupe: 'Formations pour vos équipes', items: [
    { v: 'Acculturation IA : utiliser l’IA au quotidien', cle: 'acculturation' },
    { v: 'IA & Métiers', cle: 'metiers' },
    { v: 'IA, RGPD & réglementation', cle: 'rgpd-reglementation' },
    { v: 'Vibe coding : créer une application avec l’IA', cle: 'vibe-coding' },
  ] },
  { groupe: 'Sur mesure', items: [
    { v: 'Capsules e-learning sur mesure', cle: 'e-learning' },
    { v: 'Formation sur mesure pour mon entreprise', cle: 'sur-mesure' },
  ] },
  { groupe: 'Pas encore décidé', items: [{ v: 'Je ne sais pas encore, conseillez-moi', cle: 'conseil' }] },
];
const autres = ['Bootcamp Claude', 'Bootcamp ChatGPT', 'Bootcamp Copilot', 'Cerveau IA', 'Acculturation IA', 'IA & Métiers', 'RGPD & réglementation', 'Vibe coding', 'E-learning sur mesure'];
const organisations = ['En individuel', 'Un seul groupe', 'Plusieurs groupes', 'À définir ensemble'];
const outils = ['ChatGPT', 'Claude', 'Copilot', 'Gemini', 'Mistral', 'Aucun pour l’instant'];
const effectifs = ['1 à 10', '11 à 50', '51 à 250', 'Plus de 250'];
const niveaux = ['Débutant', 'Intermédiaire', 'Avancé', 'Niveaux mixtes'];
const metiers = ['Marketing & communication', 'Commercial', 'Administration & gestion', 'Management', 'RH', 'Autre'];
const formats = ['Distanciel', 'Présentiel', 'E-learning', 'À définir ensemble'];
const echeances = ['Dès que possible', 'Sous 1 mois', 'Sous 3 mois', 'Pas de date précise'];
const opco = ['Oui', 'Non', 'Je ne sais pas'];
const creneaux = ['Le matin', "L'après-midi", 'Peu importe'];
// Questions supplémentaires affichées pour une demande sur mesure ou e-learning.
const smTypes = ['Formation adaptée à nos outils internes', 'Parcours différent par métier ou service', 'Capsules e-learning (vidéos, quiz)', 'Atelier sur un cas concret de l’entreprise', 'Accompagnement d’un projet IA', 'Autre'];
const smLivrables = ['Supports PDF', 'Vidéos', 'Quiz et exercices', 'Modules pour notre LMS (SCORM)', 'Ateliers en direct', 'À définir ensemble'];
const smBudgets = ['Moins de 2 000 €', '2 000 à 5 000 €', '5 000 à 15 000 €', 'Plus de 15 000 €', 'Je ne sais pas encore'];
const etapes = ['Votre besoin', 'Votre équipe', 'Les modalités', 'Vos coordonnées'];
---

<Layout
  title="Devis formation IA sous 2 h | Capsule IA"
  description="Décrivez votre besoin de formation à l'IA en 4 étapes : devis garanti sous 2 h, rappel d'un formateur sous 48 h, financement OPCO possible."
  fil="Devis"
>
  <div class="devis">
    <header class="dv-nav">
      <a class="dv-logo" href="/" aria-label="Capsule IA — accueil">
        <img src="/img/logo.webp" alt="Capsule IA — retour à l'accueil" width="96" height="96" />
      </a>
      <nav aria-label="Navigation principale">
        <a href="/#formations">Nos formations</a>
        <a href="/#approche">Notre approche</a>
        <a href="/#a-propos">À propos</a>
      </nav>
      <a class="dv-pill" href="/#modules">Découvrir nos modules</a>
    </header>

    <main class="dv-main">
      <section class="dv-intro">
        <p class="dv-eyebrow">Devis interactif</p>
        <h1>Parlons de<br /><span>vos besoins.</span></h1>
        <p class="dv-lead">
          Quatre étapes, deux minutes. Vous décrivez votre projet, nous construisons une proposition adaptée à vos
          équipes.
        </p>
        <ul class="dv-promesses">
          <li>
            <strong>2 h</strong>
            <span>Devis garanti<br />sous 2 heures</span>
          </li>
          <li>
            <strong>48 h</strong>
            <span>Rappel d'un formateur<br />sous 48 heures</span>
          </li>
        </ul>

        <aside class="dv-recap" aria-live="polite">
          <h2>Votre demande</h2>
          <dl id="dv-recap-list">
            <dt>Aucune sélection</dt>
            <dd>Vos choix apparaîtront ici.</dd>
          </dl>
        </aside>
      </section>

      <form
        class="dv-form"
        id="dv-form"
        name="devis"
        data-netlify="true"
        netlify-honeypot="site-web-pot"
        action="/devis/?envoye=1"
        method="post"
        data-endpoint={endpoint}
        data-email={email}
        novalidate
      >
        <input type="hidden" name="form-name" value="devis" />
        <input type="hidden" name="subject" data-remove-prefix value="Nouvelle demande de devis" />
        <input type="hidden" name="Résumé de la demande" value="" />
        <p hidden><label>Ne pas remplir : <input name="site-web-pot" tabindex="-1" autocomplete="off" /></label></p>
        <ol class="dv-steps" aria-label="Étapes du devis">
          {etapes.map((e, i) => (
            <li data-step-dot={i}>
              <b>{i + 1}</b>
              <span>{e}</span>
            </li>
          ))}
        </ol>
        <div class="dv-bar"><i id="dv-progress"></i></div>

        <fieldset class="dv-step" data-step="0">
          <legend>Quelle formation vous intéresse ?</legend>
          <label class="dv-field">
            <span>Formation souhaitée en priorité</span>
            <select name="Formation" id="dv-formation" required>
              <option value="">Choisir dans la liste…</option>
              {catalogue.map((g) => (
                <optgroup label={g.groupe}>
                  {g.items.map((f) => <option value={f.v} data-cle={f.cle}>{f.v}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
          <p class="dv-aide" id="dv-aide" hidden></p>
          <fieldset class="dv-sm" id="dv-sm" disabled hidden>
            <legend class="dv-sm-titre">Votre projet sur mesure</legend>
            <p class="dv-hint">Quelques précisions pour que notre proposition colle vraiment à votre besoin.</p>
            <p class="dv-label">Que recherchez-vous exactement ?</p>
            <div class="dv-chips">
              {smTypes.map((t) => (
                <label class="dv-opt"><input type="checkbox" name="Sur mesure : type de besoin" value={t} />{t}</label>
              ))}
            </div>
            <label class="dv-field">
              <span>Décrivez précisément votre besoin</span>
              <textarea name="Sur mesure : besoin détaillé" rows="4" required placeholder="Votre contexte, le problème à résoudre, ce que vos équipes doivent obtenir à la fin, les contraintes éventuelles…"></textarea>
            </label>
            <label class="dv-field">
              <span>Outils et logiciels de l'entreprise <em>(facultatif)</em></span>
              <input type="text" name="Sur mesure : outils internes" placeholder="Ex. : Microsoft 365, Salesforce, Sage, Notion…" />
            </label>
            <p class="dv-label">Livrables souhaités <em>(facultatif)</em></p>
            <div class="dv-chips">
              {smLivrables.map((t) => (
                <label class="dv-opt"><input type="checkbox" name="Sur mesure : livrables" value={t} />{t}</label>
              ))}
            </div>
            <label class="dv-field">
              <span>Budget indicatif <em>(facultatif)</em></span>
              <select name="Sur mesure : budget">
                <option value="">Choisir…</option>
                {smBudgets.map((t) => <option>{t}</option>)}
              </select>
            </label>
          </fieldset>
          <p class="dv-label">D'autres formations vous intéressent aussi ? <em>(facultatif)</em></p>
          <div class="dv-chips">
            {autres.map((t) => (
              <label class="dv-opt"><input type="checkbox" name="Autres formations" value={t} />{t}</label>
            ))}
          </div>
          <label class="dv-field">
            <span>Votre objectif : que doivent savoir faire les participants à la fin ?</span>
            <textarea name="Objectif" rows="3" required placeholder="Ex. : rédiger nos devis et comptes rendus avec l’IA, créer un agent qui trie les demandes clients…"></textarea>
          </label>
          <p class="dv-error" hidden>Choisissez une formation et décrivez votre objectif en une phrase (et votre besoin, pour une demande sur mesure).</p>
        </fieldset>

        <fieldset class="dv-step" data-step="1">
          <legend>Parlez-nous de votre équipe</legend>
          <div class="dv-grid">
            <label class="dv-field">
              <span>Nombre de personnes à former</span>
              <input type="number" name="Participants" min="1" max="5000" step="1" inputmode="numeric" required placeholder="Ex. : 8" />
              <small class="dv-note">Un ordre d'idée suffit.</small>
            </label>
            <label class="dv-field">
              <span>Effectif total de l'entreprise</span>
              <select name="Effectif entreprise" required>
                <option value="">Choisir…</option>
                {effectifs.map((t) => <option>{t}</option>)}
              </select>
            </label>
          </div>
          <p class="dv-label">Organisation souhaitée</p>
          <div class="dv-chips">
            {organisations.map((t) => (
              <label class="dv-opt"><input type="radio" name="Organisation" value={t} required />{t}</label>
            ))}
          </div>
          <p class="dv-label">Niveau actuel en IA</p>
          <div class="dv-chips">
            {niveaux.map((t) => (
              <label class="dv-opt"><input type="radio" name="Niveau" value={t} required />{t}</label>
            ))}
          </div>
          <p class="dv-label">Métiers concernés <em>(facultatif)</em></p>
          <div class="dv-chips">
            {metiers.map((t) => (
              <label class="dv-opt"><input type="checkbox" name="Métiers" value={t} />{t}</label>
            ))}
          </div>
          <p class="dv-label">Assistants IA déjà utilisés dans l'entreprise <em>(facultatif)</em></p>
          <div class="dv-chips">
            {outils.map((t) => (
              <label class="dv-opt"><input type="checkbox" name="Outils déjà utilisés" value={t} />{t}</label>
            ))}
          </div>
          <p class="dv-error" hidden>Indiquez le nombre de personnes, l'effectif, l'organisation et le niveau.</p>
        </fieldset>

        <fieldset class="dv-step" data-step="2">
          <legend>Comment souhaitez-vous vous former ?</legend>
          <p class="dv-label">Format</p>
          <div class="dv-chips">
            {formats.map((t) => (
              <label class="dv-opt"><input type="radio" name="Format" value={t} required />{t}</label>
            ))}
          </div>
          <p class="dv-label">Échéance souhaitée</p>
          <div class="dv-chips">
            {echeances.map((t) => (
              <label class="dv-opt"><input type="radio" name="Échéance" value={t} required />{t}</label>
            ))}
          </div>
          <p class="dv-label">Financement par votre OPCO envisagé ?</p>
          <div class="dv-chips">
            {opco.map((t) => (
              <label class="dv-opt"><input type="radio" name="OPCO" value={t} />{t}</label>
            ))}
          </div>
          <p class="dv-error" hidden>Indiquez le format et l'échéance.</p>
        </fieldset>

        <fieldset class="dv-step" data-step="3">
          <legend>Où vous envoyer le devis ?</legend>
          <div class="dv-grid">
            <label class="dv-field">
              <span>Prénom et nom</span>
              <input type="text" name="Nom" autocomplete="name" required />
            </label>
            <label class="dv-field">
              <span>Entreprise</span>
              <input type="text" name="Entreprise" autocomplete="organization" required />
            </label>
            <label class="dv-field">
              <span>Secteur d'activité</span>
              <input type="text" name="Secteur" placeholder="Ex. : paysage, expertise comptable, industrie…" required />
            </label>
            <label class="dv-field">
              <span>E-mail professionnel</span>
              <input type="email" name="E-mail" autocomplete="email" required />
            </label>
            <label class="dv-field">
              <span>Téléphone</span>
              <input type="tel" name="Téléphone" autocomplete="tel" required pattern="[0-9+ .\(\)\-]{8,}" />
            </label>
          </div>
          <p class="dv-label">Quand préférez-vous être rappelé ?</p>
          <div class="dv-chips">
            {creneaux.map((t, i) => (
              <label class="dv-opt"><input type="radio" name="Rappel" value={t} checked={i === 2} />{t}</label>
            ))}
          </div>
          <label class="dv-field">
            <span>Précisions <em>(facultatif)</em></span>
            <textarea name="Message" rows="4" placeholder="Contexte, outils déjà utilisés, objectifs…"></textarea>
          </label>
          <label class="dv-consent">
            <input type="checkbox" name="Consentement" value="Oui" required />
            <span>J'accepte que Capsule IA utilise ces informations pour établir mon devis et me recontacter.</span>
          </label>
          <p class="dv-error" hidden>Complétez vos coordonnées et cochez la case d'accord.</p>
        </fieldset>

        <div class="dv-actions">
          <button type="button" class="dv-btn dv-btn--ghost" id="dv-prev">← Retour</button>
          <button type="button" class="dv-btn" id="dv-next">Continuer →</button>
          <button type="submit" class="dv-btn dv-btn--send" id="dv-send">Recevoir mon devis sous 2 h</button>
        </div>
        <p class="dv-status" id="dv-status" role="status"></p>
      </form>

      <section class="dv-merci" id="dv-merci" hidden tabindex="-1">
        <div class="dv-check" aria-hidden="true">✓</div>
        <h2 id="dv-merci-titre">Merci, votre demande est bien partie.</h2>
        <p id="dv-merci-texte">
          Vous recevrez votre devis par e-mail sous 2 heures, et un formateur vous rappellera sous 48 heures.
        </p>
        <a class="dv-btn" href="/">Retour à l'accueil</a>
      </section>
    </main>
  </div>

  <script>
    function initDevis() {
      const form = document.getElementById('dv-form');
      if (!form || form.dataset.ready) return;
      form.dataset.ready = '1';
      form.classList.add('is-js');

      const steps = [...form.querySelectorAll('.dv-step')];
      const dots = [...form.querySelectorAll('[data-step-dot]')];
      const prev = document.getElementById('dv-prev');
      const next = document.getElementById('dv-next');
      const send = document.getElementById('dv-send');
      const bar = document.getElementById('dv-progress');
      const status = document.getElementById('dv-status');
      const recap = document.getElementById('dv-recap-list');
      const merci = document.getElementById('dv-merci');
      let current = 0;

      const TECHNIQUES = ['form-name', 'subject', 'Résumé de la demande', 'site-web-pot'];
      const values = () => {
        const out = {};
        for (const [k, v] of new FormData(form)) {
          if (!String(v).trim() || TECHNIQUES.includes(k)) continue;
          out[k] = out[k] ? out[k] + ', ' + v : String(v);
        }
        return out;
      };

      const renderRecap = () => {
        const v = values();
        delete v.Consentement;
        const keys = Object.keys(v);
        recap.textContent = '';
        if (!keys.length) {
          const dt = document.createElement('dt');
          dt.textContent = 'Aucune sélection';
          const dd = document.createElement('dd');
          dd.textContent = 'Vos choix apparaîtront ici.';
          recap.append(dt, dd);
          return;
        }
        keys.forEach((k) => {
          const dt = document.createElement('dt');
          dt.textContent = k;
          const dd = document.createElement('dd');
          dd.textContent = v[k];
          recap.append(dt, dd);
        });
      };

      const valid = (i) => {
        const step = steps[i];
        const ok = [...step.querySelectorAll('input, textarea, select')].every((el) => el.checkValidity());
        step.querySelector('.dv-error').hidden = ok;
        return ok;
      };

      const show = (i, focus = true) => {
        current = i;
        steps.forEach((s, n) => s.classList.toggle('is-active', n === i));
        dots.forEach((d, n) => {
          d.classList.toggle('is-active', n === i);
          d.classList.toggle('is-done', n < i);
        });
        bar.style.width = ((i + 1) / steps.length) * 100 + '%';
        prev.hidden = i === 0;
        next.hidden = i === steps.length - 1;
        send.hidden = i !== steps.length - 1;
        if (focus) steps[i].querySelector('legend').scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      // Formation : aide contextuelle selon le choix, et présélection par /devis/?formation=<clé>.
      const choix = document.getElementById('dv-formation');
      const aide = document.getElementById('dv-aide');
      const AIDES = {
        bootcamp: 'Les bootcamps suivent un programme fixe de 16 heures, en individuel. Indiquez à l’étape suivante combien de personnes vous souhaitez former.',
        'cerveau-ia': 'Formation de 16 heures, en individuel ou en binôme (dirigeant et référent), appliquée à votre cas réel.',
        'e-learning': 'Précisez dans l’encadré ci-dessous le sujet des capsules, le public visé et le nombre de modules envisagé.',
        'sur-mesure': 'Quelques questions de plus ci-dessous : nous construisons ensuite le programme avec vous, après un échange.',
        conseil: 'Décrivez simplement votre situation : nous vous recommandons la formation la plus adaptée.',
      };
      const majAide = () => {
        const cle = choix.selectedOptions[0]?.dataset.cle || '';
        const texte = AIDES[cle.startsWith('bootcamp') ? 'bootcamp' : cle] || '';
        aide.textContent = texte;
        aide.hidden = !texte;
      };
      // Encadré « sur mesure » : s'ouvre pour une formation sur mesure ou e-learning.
      const sm = document.getElementById('dv-sm');
      const elearningCoche = form.querySelector('input[name="Autres formations"][value="E-learning sur mesure"]');
      const majSurMesure = () => {
        const cle = choix.selectedOptions[0]?.dataset.cle || '';
        const ouvert = cle === 'sur-mesure' || cle === 'e-learning' || !!elearningCoche?.checked;
        if (ouvert === !sm.hidden) return;
        sm.hidden = !ouvert;
        sm.disabled = !ouvert;
        if (ouvert) sm.animate([{ opacity: 0, transform: 'translateY(-8px)' }, { opacity: 1, transform: 'none' }], { duration: 350, easing: 'cubic-bezier(.2,.7,.2,1)' });
      };
      choix.addEventListener('change', () => { majAide(); majSurMesure(); });
      elearningCoche?.addEventListener('change', majSurMesure);
      const demandee = new URLSearchParams(location.search).get('formation');
      if (demandee) {
        const opt = [...choix.options].find((o) => o.dataset.cle === demandee);
        if (opt) { choix.value = opt.value; majAide(); majSurMesure(); }
      }

      next.addEventListener('click', () => valid(current) && show(current + 1));
      prev.addEventListener('click', () => show(current - 1));
      form.addEventListener('input', () => {
        renderRecap();
        const err = steps[current].querySelector('.dv-error');
        if (!err.hidden) valid(current);
      });

      const done = (viaMail) => {
        form.hidden = true;
        merci.hidden = false;
        if (viaMail) {
          document.getElementById('dv-merci-titre').textContent = 'Dernière étape : envoyez l’e-mail.';
          document.getElementById('dv-merci-texte').textContent =
            'Votre messagerie vient de s’ouvrir avec votre demande déjà rédigée. Envoyez l’e-mail pour la valider : devis sous 2 heures, rappel sous 48 heures.';
        }
        merci.focus();
        merci.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        for (let i = 0; i < steps.length; i++) {
          if (!valid(i)) return show(i);
        }
        const v = values();
        const { endpoint, email } = form.dataset;
        if (!endpoint) {
          const body = Object.entries(v)
            .map(([k, val]) => `${k} : ${val}`)
            .join('\n');
          const subject = `Demande de devis — ${v.Entreprise || ''}`;
          window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          return done(true);
        }
        send.disabled = true;
        status.textContent = 'Envoi en cours…';
        try {
          // Résumé lisible en tête de l'e-mail (seules les réponses remplies), et objet explicite.
          const champs = { ...v };
          delete champs['form-name']; delete champs.subject; delete champs['Résumé de la demande']; delete champs['site-web-pot'];
          const resume = Object.entries(champs).map(([k, val]) => `${k} : ${val}`).join('\n');
          const sujet = `Demande de devis — ${v.Entreprise || v.Nom || 'nouveau contact'} — ${v.Formation || ''}`;
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ ...champs, 'form-name': 'devis', subject: sujet, 'Résumé de la demande': resume }).toString(),
          });
          if (!res.ok) throw new Error(String(res.status));
          window.dispatchEvent(new CustomEvent('capsule:devis'));
          done(false);
        } catch {
          send.disabled = false;
          status.textContent = `L'envoi a échoué. Réessayez, ou écrivez-nous à ${email}.`;
        }
      });

      renderRecap();
      show(0, false);
    }
    document.addEventListener('astro:page-load', initDevis);
  </script>

  <style is:global>
    .devis {
      --yellow: #ffe897; --magenta: #c40d60; --salmon: #ff8565; --teal: #66d1da;
      --cream: #f6f8ef; --ink: #1c1712;
      min-height: 100vh; background: var(--cream); color: var(--ink);
      font-family: 'Poppins', system-ui, sans-serif;
    }
    .dv-nav { display: flex; align-items: center; gap: 24px; padding: 10px clamp(16px, 4vw, 56px); background: #fff; box-shadow: 0 8px 18px -14px rgba(0, 0, 0, .35); }
    .dv-logo img { width: 84px; height: 84px; transition: rotate .5s cubic-bezier(.3, 1.5, .5, 1); }
    .dv-logo:hover img { rotate: -8deg; }
    .dv-nav nav { display: flex; gap: clamp(16px, 4vw, 64px); margin-inline: auto; font-size: 15px; color: #353535; }
    .dv-nav nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
    .dv-pill { background: var(--yellow); padding: 10px 22px; border-radius: 999px; font-weight: 700; font-style: italic; letter-spacing: -.05em; white-space: nowrap; box-shadow: 0 9px 14px -6px rgba(0, 0, 0, .3); }

    .dv-main { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 4vw, 64px); max-width: 1240px; margin: 0 auto; padding: clamp(32px, 6vw, 80px) clamp(16px, 4vw, 40px) 96px; align-items: start; }
    .dv-intro { position: sticky; top: 28px; }
    .dv-eyebrow { margin: 0 0 14px; font-size: 13px; font-weight: 700; letter-spacing: .45em; text-transform: uppercase; color: #353535; }
    .dv-intro h1 { margin: 0; font: 700 clamp(44px, 5.4vw, 78px)/.95 'Inter Variable', Inter, sans-serif; letter-spacing: -.05em; text-wrap: balance; }
