---
import Layout from '../../layouts/Layout.astro';
import EnTete from '../../components/EnTete.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ressources } from '../../data/ressources.js';

export function getStaticPaths() {
  return ressources.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const autres = ressources.filter((a) => a.slug !== r.slug);
const dateLisible = new Date(r.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const schema = [
  {
    '@type': 'Article',
    headline: r.titre,
    description: r.description,
    datePublished: r.date,
    dateModified: r.date,
    inLanguage: 'fr-FR',
    mainEntityOfPage: new URL(`/ressources/${r.slug}/`, Astro.site),
    image: new URL('/partage.jpg', Astro.site),
    author: { '@id': new URL('/#organisme', Astro.site) },
    publisher: { '@id': new URL('/#organisme', Astro.site) },
  },
];
---

<Layout title={`${r.titre} | Capsule IA`} description={r.description} fil={r.titre} schema={schema}>
  <EnTete />
  <main class="ar">
    <article>
      <header>
        <p class="ar-fil"><a href="/ressources/">Ressources</a> · {r.theme}</p>
        <h1>{r.titre}</h1>
        <p class="ar-meta">Par l'équipe Capsule IA · <time datetime={r.date}>{dateLisible}</time> · {r.lecture} min de lecture</p>
      </header>
      <div class="ar-corps" set:html={r.corps} />
      <aside class="ar-suite">
        <p>Pour aller plus loin avec vos équipes, découvrez <a href={r.module.href}>{r.module.nom}</a>.</p>
      </aside>
    </article>
    <nav class="ar-autres" aria-label="Autres guides">
      <h2>À lire aussi</h2>
      <ul>
        {autres.map((a) => <li><a href={`/ressources/${a.slug}/`}><span>{a.theme}</span>{a.titre}</a></li>)}
      </ul>
    </nav>
  </main>
  <CtaBand />
</Layout>

<style is:global>
  .ar { background: #f6f8ef; color: #1c1712; font-family: 'Poppins', sans-serif; padding: clamp(32px, 5vw, 72px) 20px clamp(48px, 7vw, 96px); }
  .ar article { max-width: 760px; margin: 0 auto; background: #fff; border-radius: clamp(24px, 3vw, 40px); padding: clamp(24px, 5vw, 64px); box-shadow: 0 18px 30px -20px rgba(0, 0, 0, .35); }
  .ar-fil { margin: 0 0 18px; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #c40d60; }
  .ar-fil a { text-decoration: underline; text-underline-offset: 4px; }
  .ar h1 { margin: 0; font: 700 clamp(32px, 4.6vw, 54px)/1.02 'Inter Variable', Inter, sans-serif; letter-spacing: -.045em; text-wrap: balance; }
  .ar-meta { margin: 18px 0 0; font-size: 14px; color: #5a544d; }
  .ar-corps { margin-top: 30px; font-size: 17px; line-height: 1.7; }
  .ar-corps h2 { margin: 38px 0 10px; font: 700 clamp(22px, 2.6vw, 28px)/1.15 'Inter Variable', Inter, sans-serif; letter-spacing: -.03em; }
  .ar-corps p { margin: 0 0 16px; }
  .ar-corps ul, .ar-corps ol { margin: 0 0 16px; padding-left: 24px; }
  .ar-corps li { margin-bottom: 8px; }
  .ar-corps li::marker { color: #c40d60; font-weight: 700; }
  .ar-corps .note { margin-top: 28px; font-size: 14px; color: #5a544d; font-style: italic; }
  .ar-suite { margin-top: 34px; padding: 20px 24px; border-radius: 20px; background: #ffe897; font-weight: 700; }
  .ar-suite p { margin: 0; }
  .ar-suite a { color: #c40d60; text-decoration: underline; text-underline-offset: 4px; }
  .ar-autres { max-width: 760px; margin: 44px auto 0; }
  .ar-autres h2 { margin: 0 0 16px; font: 700 26px/1.1 'Inter Variable', Inter, sans-serif; letter-spacing: -.03em; }
  .ar-autres ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ar-autres a { display: block; background: #fff; border-radius: 18px; padding: 16px 20px; font-weight: 700; line-height: 1.3; transition: transform .2s; }
  .ar-autres a:hover { transform: translateX(6px); }
  .ar-autres span { display: block; font-size: 12px; color: #c40d60; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 4px; }
</style>
