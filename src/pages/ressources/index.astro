---
import Layout from '../../layouts/Layout.astro';
import EnTete from '../../components/EnTete.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ressources } from '../../data/ressources.js';

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Ressources sur la formation à l’IA',
    url: new URL('/ressources/', Astro.site),
    hasPart: ressources.map((r) => ({ '@type': 'Article', headline: r.titre, url: new URL(`/ressources/${r.slug}/`, Astro.site) })),
  },
];
---

<Layout
  title="Ressources : guides pratiques sur l'IA en entreprise | Capsule IA"
  description="Guides pratiques de Capsule IA : rédiger un bon prompt, utiliser l'IA dans le respect du RGPD, comprendre le vibe coding, financer une formation avec son OPCO."
  fil="Ressources"
  schema={schema}
>
  <EnTete />
  <main class="rs">
    <header class="rs-intro">
      <p class="rs-eyebrow">Ressources</p>
      <h1>Des repères <span>pour avancer.</span></h1>
      <p class="rs-lead">Des guides courts et concrets pour comprendre l'IA, l'utiliser avec les bons réflexes et préparer la formation de vos équipes.</p>
      <p class="rs-broch"><a href="/Brochure-Capsule-IA.pdf" download="Brochure Capsule IA.pdf"><b>↓</b> Télécharger la brochure Capsule IA <span>PDF · 12 pages</span></a></p>
    </header>
    <ul class="rs-liste">
      {
        ressources.map((r) => (
          <li>
            <a href={`/ressources/${r.slug}/`}>
              <span class="rs-theme">{r.theme}</span>
              <h2>{r.titre}</h2>
              <p>{r.description}</p>
              <span class="rs-lire">Lire le guide · {r.lecture} min</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <CtaBand />
</Layout>

<style>
  .rs { background: #f6f8ef; color: #1c1712; font-family: 'Poppins', sans-serif; padding: clamp(40px, 6vw, 88px) 20px clamp(48px, 7vw, 100px); }
  .rs-intro { max-width: 860px; margin: 0 auto; text-align: center; }
  .rs-eyebrow { margin: 0 0 16px; font-weight: 700; font-size: clamp(11px, 1.2vw, 15px); letter-spacing: .6em; text-transform: uppercase; color: #c40d60; }
  h1 { margin: 0; font: 700 clamp(40px, 6.4vw, 88px)/.95 'Inter Variable', Inter, sans-serif; letter-spacing: -.049em; text-wrap: balance; }
  h1 span { background: rgba(255, 133, 101, .4); padding: 0 .1em; }
  .rs-lead { margin: 22px auto 0; max-width: 56ch; font-size: clamp(15px, 1.4vw, 18px); line-height: 1.55; }
  .rs-liste { list-style: none; margin: clamp(32px, 5vw, 64px) auto 0; padding: 0; max-width: 1100px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 22px; }
  .rs-liste a { display: flex; flex-direction: column; gap: 12px; height: 100%; background: #fff; border-radius: 28px; padding: clamp(22px, 3vw, 34px); box-shadow: 0 16px 26px -18px rgba(0, 0, 0, .35); transition: transform .25s cubic-bezier(.3, 1.4, .5, 1), box-shadow .25s; }
  .rs-liste a:hover { transform: translateY(-5px); box-shadow: 0 24px 30px -18px rgba(0, 0, 0, .4); }
  .rs-theme { align-self: flex-start; background: #ffe897; padding: 5px 14px; border-radius: 99px; font-size: 12px; font-weight: 700; }
  h2 { margin: 0; font: 700 clamp(22px, 2.3vw, 28px)/1.12 'Inter Variable', Inter, sans-serif; letter-spacing: -.03em; text-wrap: balance; }
  .rs-liste p { margin: 0; font-size: 15px; line-height: 1.55; color: #4a443d; }
  .rs-lire { margin-top: auto; padding-top: 6px; font-weight: 700; font-style: italic; color: #c40d60; font-size: 15px; }
  .rs-broch { margin: 26px 0 0; }
  .rs-broch a { display: inline-flex; align-items: center; gap: 10px; background: #c40d60; color: #fff; padding: 13px 24px; border-radius: 999px; font: 700 15px/1.2 'Poppins', sans-serif; box-shadow: 0 12px 18px -10px rgba(0, 0, 0, .45); transition: transform .25s cubic-bezier(.3, 1.4, .5, 1); }
  .rs-broch a:hover { transform: translateY(-3px); }
  .rs-broch b { color: #ffe897; font-size: 18px; }
  .rs-broch span { font-weight: 400; opacity: .85; font-size: 13px; }
</style>
