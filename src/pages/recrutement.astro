---
// Page Recrutement : deux formulaires Netlify Forms (formateurs et stagiaires).
// Les candidatures arrivent dans Netlify (Forms) ; aucun fichier n'est téléversé.
import Layout from '../layouts/Layout.astro';
import EnTete from '../components/EnTete.astro';
import '../styles/formation.css';
---

<Layout
  title="Recrutement : formateurs IA et stagiaires | Capsule IA"
  description="Capsule IA recrute des formateurs IA et des stagiaires (communication, commercial, dev et IA, administratif). Postulez en quelques minutes avec une courte vidéo de présentation."
  fil="Recrutement"
>
  <EnTete />
<main class="bc">
<section class="bc-hero">
<div class="bc-in">
<p class="bc-eyebrow">Recrutement</p>
<h1>
<span class="bc-kw">Rejoignez Capsule IA.</span>Formez les équipes de demain.</h1>
<p class="bc-sous">Nous recrutons des formateurs IA passionnés de pédagogie et des stagiaires — communication, commercial, dev &amp; IA, administratif… Postulez en quelques minutes avec une courte vidéo.</p>
<ul class="bc-puces">
<li>
<b>Formateurs</b> experts IA</li>
<li>
<b>Stagiaires</b> tous profils</li>
<li>
<b>Vidéo</b> Loom ou Drive, 2-3 min</li>
<li>
<b>Réponse</b> sous 48 h</li>
</ul>
<p class="bc-actions">
<a class="bc-btn" href="#formateurs">Devenir formateur</a>
<a class="bc-lien" href="#stagiaires">Postuler en stage ↓</a>
</p>
</div>
</section>
<section class="rec">
<div class="rec-in">
<p class="rec-note">Deux formulaires simples, un seul réflexe : <b>une courte vidéo de présentation</b> hébergée sur Loom, Google Drive ou YouTube non répertoriée. Aucun fichier à téléverser ici — collez simplement le lien. Chaque candidature arrive directement dans la boîte mail de l'équipe Capsule IA.</p>
<div class="rec-grid">
<article class="rec-card" id="formateurs">
<span class="rec-badge">Formateurs</span>
<h2>Vous formez les équipes à l'IA</h2>
<p class="rec-lead">Vous maîtrisez un univers IA (Claude, ChatGPT, Copilot, RGPD, vibe coding...) et vous adorez transmettre ? Rejoignez le collectif de formateurs Capsule IA pour animer nos bootcamps et acculturations.</p>
<form name="recrutement-formateurs" method="POST" data-netlify="true" data-astro-reload netlify-honeypot="societe" action="/recrutement/?envoye=formateurs#formateurs">
<input type="hidden" name="form-name" value="recrutement-formateurs" />
<p class="rec-hp">
<label>Ne pas remplir : <input name="societe" tabindex="-1" autocomplete="off" />
</label>
</p>
<div class="rec-f">
<label for="f-nom">Prénom et nom<em>*</em>
</label>
<input id="f-nom" name="nom" type="text" required />
</div>
<div class="rec-f">
<label for="f-email">E-mail<em>*</em>
</label>
<input id="f-email" name="email" type="email" placeholder="prenom@exemple.fr" required />
</div>
<div class="rec-f">
<label for="f-telephone">Téléphone</label>
<input id="f-telephone" name="telephone" type="tel" placeholder="+33 6 00 00 00 00" />
</div>
<div class="rec-f">
<label>Niveau d'expertise<em>*</em>
</label>
<div class="rec-choices">
<label>
<input type="radio" name="niveau" value="Intermédiaire" />Intermédiaire</label>
<label>
<input type="radio" name="niveau" value="Confirmé" />Confirmé</label>
<label>
<input type="radio" name="niveau" value="Expert" />Expert</label>
</div>
</div>
<div class="rec-f">
<label>Sujets d'expertise</label>
<div class="rec-choices">
<label>
<input type="checkbox" name="sujets" value="Claude" />Claude</label>
<label>
<input type="checkbox" name="sujets" value="ChatGPT et GPTs" />ChatGPT et GPTs</label>
<label>
<input type="checkbox" name="sujets" value="Copilot et Microsoft 365" />Copilot et Microsoft 365</label>
<label>
<input type="checkbox" name="sujets" value="RGPD et AI Act" />RGPD et AI Act</label>
<label>
<input type="checkbox" name="sujets" value="Vibe coding" />Vibe coding</label>
<label>
<input type="checkbox" name="sujets" value="Acculturation IA" />Acculturation IA</label>
<label>
<input type="checkbox" name="sujets" value="Autre" />Autre</label>
</div>
</div>
<div class="rec-f">
<label for="f-lien-video">Lien de votre vidéo de présentation<em>*</em>
</label>
<input id="f-lien-video" name="lien-video" type="url" placeholder="https://www.loom.com/share/..." required />
<p class="rec-hint">Pas de téléversement : hébergez une courte vidéo de présentation (2 à 3 min) sur Loom, Google Drive ou YouTube non répertoriée, puis collez simplement le lien.</p>
</div>
<div class="rec-f">
<label for="f-message">Quelques mots sur vous (facultatif)</label>
<textarea id="f-message" name="message">
</textarea>
</div>
<p class="rec-submit">
<button class="bc-btn" type="submit">Envoyer ma candidature</button>
</p>
</form>
<div class="rec-ok">
<div class="rec-ok-badge">✓</div>
<h2>Candidature bien reçue !</h2>
<p>Merci ! Votre candidature de formateur est bien arrivée. Nous regardons votre vidéo et revenons vers vous sous 48 h.</p>
</div>
</article>
<article class="rec-card" id="stagiaires">
<span class="rec-badge">Stagiaires</span>
<h2>Stage chez Capsule IA</h2>
<p class="rec-lead">Vous cherchez un stage concret — communication, commercial, dev &amp; IA, administratif… — au cœur d'un organisme de formation IA en pleine croissance ? Montrez-nous votre énergie en vidéo.</p>
<form name="recrutement-stagiaires" method="POST" data-netlify="true" data-astro-reload netlify-honeypot="societe" action="/recrutement/?envoye=stagiaires#stagiaires">
<input type="hidden" name="form-name" value="recrutement-stagiaires" />
<p class="rec-hp">
<label>Ne pas remplir : <input name="societe" tabindex="-1" autocomplete="off" />
</label>
</p>
<div class="rec-f">
<label for="s-nom">Prénom et nom<em>*</em>
</label>
<input id="s-nom" name="nom" type="text" required />
</div>
<div class="rec-f">
<label for="s-email">E-mail<em>*</em>
</label>
<input id="s-email" name="email" type="email" placeholder="prenom@exemple.fr" required />
</div>
<div class="rec-f">
<label for="s-telephone">Téléphone</label>
<input id="s-telephone" name="telephone" type="tel" placeholder="+33 6 00 00 00 00" />
</div>
<div class="rec-f">
<label for="s-poste">Intitulé du poste<em>*</em>
</label>
<select id="s-poste" name="poste" required>
<option>Communication</option>
<option>Commercial (sales)</option>
<option>Dev &amp; IA</option>
<option>Administratif</option>
<option>Autre</option>
</select>
</div>
<div class="rec-f">
<label for="s-disponibilite">Disponibilité</label>
<select id="s-disponibilite" name="disponibilite">
<option>Dès que possible</option>
<option>Sous 1 mois</option>
<option>Sous 3 mois</option>
<option>Autre</option>
</select>
</div>
<div class="rec-f">
<label for="s-lien-video">Lien de votre vidéo de présentation<em>*</em>
</label>
<input id="s-lien-video" name="lien-video" type="url" placeholder="https://www.loom.com/share/..." required />
<p class="rec-hint">Pas de téléversement : hébergez une courte vidéo de présentation (2 à 3 min) sur Loom, Google Drive ou YouTube non répertoriée, puis collez simplement le lien.</p>
</div>
<div class="rec-f">
<label for="s-message">Quelques mots sur vous (facultatif)</label>
<textarea id="s-message" name="message">
</textarea>
</div>
<p class="rec-submit">
<button class="bc-btn" type="submit">Envoyer ma candidature</button>
</p>
</form>
<div class="rec-ok">
<div class="rec-ok-badge">✓</div>
<h2>Candidature bien reçue !</h2>
<p>Merci ! Votre candidature est bien arrivée. Nous regardons votre vidéo et revenons vers vous sous 48 h.</p>
</div>
</article>
</div>
<p class="rec-rgpd">Les informations transmises via ces formulaires servent uniquement à traiter votre candidature. Elles ne sont ni cédées ni conservées au-delà du processus de recrutement. Conformément au RGPD, vous pouvez demander leur accès ou leur suppression à <a href="mailto:contact@capsuleia.fr">contact@capsuleia.fr</a>.</p>
</div>
</section>
</main>
</Layout>

<script is:inline>
  // Après l'envoi, Netlify revient sur la page avec ?envoye=… : on affiche le message de confirmation.
  (function () {
    if (window.__capsuleRec) return;
    window.__capsuleRec = true;
    function confirmer() {
      var m = location.search.match(/envoye=(formateurs|stagiaires)/);
      var c = m && document.getElementById(m[1]);
      if (c) { c.classList.add('rec-ok-on'); setTimeout(function () { c.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 80); }
    }
    document.addEventListener('astro:page-load', confirmer);
    if (document.readyState !== 'loading') confirmer();
  })();
</script>

<style is:global>
.rec{padding:clamp(2.5rem,6vw,4.5rem) 0 clamp(3rem,8vw,5.5rem);background:#fff8ed}
.rec-in{max-width:1140px;margin:0 auto;padding:0 clamp(1rem,4vw,2rem)}
.rec-note{max-width:760px;margin:0 auto 2.6rem;text-align:center;font-size:1.05rem;line-height:1.65;color:#4a3f33}
.rec-note b{color:#c40d60}
.rec-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.2rem,3vw,2.2rem);align-items:start}
@media(max-width:880px){.rec-grid{grid-template-columns:1fr}}
.rec-card{background:#fff;border:1px solid rgba(28,23,18,.1);border-radius:24px;padding:clamp(1.4rem,3.5vw,2.2rem);box-shadow:0 18px 45px -28px rgba(28,23,18,.35);scroll-margin-top:110px}
.rec-badge{display:inline-block;font:700 .72rem/1 Poppins,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:#c40d60;border-radius:999px;padding:.45rem .9rem;margin-bottom:1rem}
.rec-card h2{font-family:Poppins,sans-serif;font-weight:700;font-size:clamp(1.5rem,3vw,1.9rem);line-height:1.15;margin:0 0 .55rem;color:#1c1712}
.rec-card .rec-lead{font-size:.98rem;line-height:1.6;color:#4a3f33;margin:0 0 1.5rem}
.rec-f{margin-bottom:1.05rem}
.rec-f label{display:block;font:600 .82rem/1.3 Poppins,sans-serif;letter-spacing:.02em;color:#1c1712;margin-bottom:.4rem}
.rec-f label em{font-style:normal;color:#c40d60}
.rec-f input[type=text],.rec-f input[type=email],.rec-f input[type=tel],.rec-f input[type=url],.rec-f select,.rec-f textarea{width:100%;box-sizing:border-box;font:400 .95rem/1.4 Inter,sans-serif;color:#1c1712;background:#fff8ed;border:1.5px solid rgba(28,23,18,.18);border-radius:12px;padding:.68rem .85rem;transition:border-color .15s,box-shadow .15s}
.rec-f textarea{min-height:92px;resize:vertical}
.rec-f input:focus,.rec-f select:focus,.rec-f textarea:focus{outline:none;border-color:#c40d60;box-shadow:0 0 0 3px rgba(196,13,96,.15)}
.rec-hint{font-size:.78rem;color:#8a7d6d;margin-top:.32rem;line-height:1.45}
.rec-choices{display:flex;flex-wrap:wrap;gap:.45rem .5rem}
.rec-choices label{display:inline-flex;align-items:center;gap:.42rem;font:500 .84rem/1 Inter,sans-serif;color:#1c1712;background:#fff8ed;border:1.5px solid rgba(28,23,18,.18);border-radius:999px;padding:.5rem .8rem;cursor:pointer;margin:0;transition:border-color .15s,background .15s}
.rec-choices label:has(input:checked){border-color:#c40d60;background:rgba(196,13,96,.08)}
.rec-choices input{accent-color:#c40d60;margin:0}
.rec-hp{position:absolute;left:-9999px;top:-9999px}
.rec-submit{margin-top:1.4rem}
.rec-submit .bc-btn{width:100%;text-align:center;justify-content:center}
.rec-ok{display:none;text-align:center;padding:2.2rem 1rem}
.rec-ok .rec-ok-badge{width:64px;height:64px;margin:0 auto 1.1rem;border-radius:50%;background:#66d1da;display:flex;align-items:center;justify-content:center;font-size:1.9rem;color:#1c1712}
.rec-ok h2{margin-bottom:.6rem}
.rec-ok p{color:#4a3f33;line-height:1.6;margin:0}
.rec-card.rec-ok-on form,.rec-card.rec-ok-on .rec-lead{display:none}
.rec-card.rec-ok-on .rec-ok{display:block}
.rec-rgpd{max-width:760px;margin:2.4rem auto 0;text-align:center;font-size:.8rem;line-height:1.6;color:#8a7d6d}
.rec-rgpd a{color:#c40d60;font-weight:700}
</style>
