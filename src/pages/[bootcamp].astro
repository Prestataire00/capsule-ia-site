---
// Pages formations de 16 heures (/bootcamp-claude/, /bootcamp-chatgpt/, /bootcamp-copilot/, /cerveau-ia/).
// Contenu : src/data/bootcamps.json (pages validées). Programme PDF : public/syllabus.
import Layout from '../layouts/Layout.astro';
import EnTete from '../components/EnTete.astro';
import CtaBand from '../components/CtaBand.astro';
import { bootcamps, syllabus } from '../data/bootcamps.js';
import '../styles/formation.css';

export function getStaticPaths() {
  return bootcamps.map((b) => ({ params: { bootcamp: b.slug }, props: { b } }));
}
const { b } = Astro.props;
const pdf = syllabus[b.slug];
const url = new URL(`/${b.slug}/`, Astro.site);
const org = { '@id': new URL('/#organisme', Astro.site) };
const point = (s, nom) => (s.points.find(([k]) => k.startsWith(nom)) || [])[1];
const schema = [
  {
    '@type': 'Course',
    '@id': `${url}#formation`,
    name: b.nom,
    description: b.bref,
    url,
    inLanguage: 'fr-FR',
    provider: org,
    timeRequired: 'PT16H',
    educationalLevel: b.niveau,
    teaches: b.teaches,
    audience: { '@type': 'Audience', audienceType: b.audience },
    ...(b.instructeur && { instructor: { ...b.instructeur, worksFor: org } }),
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: ['Online', 'Onsite'], courseWorkload: 'PT16H', inLanguage: 'fr-FR' },
    syllabusSections: b.blocs.flatMap((bl) => bl.seances.map((s) => ({ '@type': 'Syllabus', name: s.titre, description: point(s, 'Objectif'), timeRequired: 'PT2H' }))),
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: b.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
  },
];
// Dégradés : chaque bloc reçoit la couleur du bloc précédent (--prev) et la sienne (--bg).
const C = { magenta: '#c40d60', creme: '#fff8ed', jaune: '#ffe897', noir: '#1c1712', clair: '#f6f8ef' };
const g = (prev, bg) => `--prev:${prev};--bg:${bg}`;
---

<Layout title={b.titre} description={b.description} fil={b.nom} schema={schema}>
  <EnTete />
  <main class="bc">
    <section class="bc-hero">
      <div class="bc-in">
        <p class="bc-eyebrow">{b.eyebrow}</p>
        <h1><span class="bc-kw">{b.kw}</span>{b.accroche}</h1>
        <p class="bc-sous">{b.sousTitre}</p>
        <ul class="bc-puces">
          {b.puces.map(([n, l]) => <li><b>{n}</b> {l}</li>)}
        </ul>
        <p class="bc-actions">
          <a class="bc-btn" href="/devis/">Demander un devis</a>
          <a class="bc-lien" href="#programme">Voir le programme ↓</a>
          {pdf && <a class="bc-lien" href={pdf.href} download>Télécharger le syllabus (PDF)</a>}
        </p>
        <div class="bca" style={`--bca-a:${b.demo.couleur}`} data-lignes={JSON.stringify(b.demo.lignes)}>
          <div class="bca-bar">
            <span class="bca-dot"></span><span class="bca-dot"></span><span class="bca-dot"></span>
            <span class="bca-title">{b.demo.titre}</span>
            <span class="bca-logo" set:html={b.demo.logo} />
          </div>
          <div class="bca-body" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="bc-bref bc-grad" style={g(C.magenta, C.creme)}>
      <div class="bc-in bc-deux">
        <div>
          <p class="bc-eyebrow bc-eyebrow--m">En bref</p>
          <p class="bc-resume">{b.bref}</p>
          <p class="bc-global"><strong>Objectif :</strong> {b.objectifGlobal}</p>
        </div>
        <dl class="bc-fiche">
          {b.fiche.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="bc-sec bc-obj bc-grad" style={g(C.creme, C.jaune)}>
      <div class="bc-in">
        <p class="bc-eyebrow bc-eyebrow--m">Objectifs pédagogiques</p>
        <h2 set:html={b.objTitre} />
        <ol class="bc-objs">
          {b.objectifs.map((o, i) => <li><b>{String(i + 1).padStart(2, '0')}</b><p>{o}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="bc-sec bc-prog bc-grad" id="programme" style={g(C.jaune, C.noir)}>
      <div class="bc-in">
        <p class="bc-eyebrow">Le programme</p>
        <h2 set:html={b.progTitre} />
        <p class="bc-lead">{b.progLead}</p>
        {b.blocs.map((bl, i) => (
          <div class="bc-bloc">
            <h3>{bl.nom} <small>{bl.duree}</small></h3>
            {bl.seances.map((s, j) => (
              <details class="bc-seance" open={i === 0 && j === 0}>
                <summary><b>{s.num}</b><span>{s.titre}</span><i>{s.duree}</i></summary>
                <div>
                  {s.points.map(([k, v]) => <p class={k.startsWith('Livrable') ? 'bc-liv' : undefined}><strong>{k}</strong> {v}</p>)}
                </div>
              </details>
            ))}
          </div>
        ))}
        {pdf && (
          <p class="bc-pdf"><a href={pdf.href} download>Télécharger le syllabus complet <span>PDF · {pdf.pages} pages</span></a></p>
        )}
      </div>
    </section>

    <section class="bc-sec bc-prat bc-grad" style={g(C.noir, C.creme)}>
      <div class="bc-in bc-deux">
        <div>
          <p class="bc-eyebrow bc-eyebrow--m">{b.prat.eyebrows[0]}</p>
          <h2 set:html={b.prat.titres[0]} />
          <ul class="bc-check">
            {b.prerequis.map((x) => <li>{x}</li>)}
          </ul>
        </div>
        <div>
          <p class="bc-eyebrow bc-eyebrow--m">{b.prat.eyebrows[1]}</p>
          <h2 set:html={b.prat.titres[1]} />
          <dl class="bc-eval">
            {b.evaluation.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <section class="bc-sec bc-resp bc-grad" style={g(C.creme, C.magenta)}>
      <div class="bc-in">
        <p class="bc-eyebrow">{b.resp.eyebrow}</p>
        <h2 set:html={b.resp.titre} />
        <p class="bc-lead">{b.resp.lead}</p>
        <ul class="bc-regles">
          {b.usageResponsable.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="bc-sec bc-form bc-grad" style={g(C.magenta, C.creme)}>
      <div class="bc-in bc-formin">
        <img src={b.formateur.photo} alt={b.formateur.nom} width="220" height="220" loading="lazy" decoding="async" />
        <div>
          <p class="bc-eyebrow bc-eyebrow--m">{b.formateur.label}</p>
          <h2>{b.formateur.nom}</h2>
          <p class="bc-role">{b.formateur.role}</p>
          <p>{b.formateur.bio}</p>
        </div>
      </div>
    </section>

    <section class="bc-sec bc-faq bc-grad" style={g(C.creme, C.clair)}>
      <div class="bc-in bc-etroit">
        <h2 set:html={b.faqTitre} />
        {b.faq.map((f, i) => (
          <details class="bc-q" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.r}</p>
          </details>
        ))}
        {b.autres.map((a) => <p class="bc-autre" set:html={a} />)}
      </div>
    </section>
    <CtaBand doc={pdf && { href: pdf.href, libelle: 'Télécharger le syllabus', detail: `PDF · ${pdf.pages} pages` }} />
  </main>
</Layout>

<script is:inline>
  // Démonstration animée du haut de page : les lignes viennent de l'attribut data-lignes.
  (function () {
    if (window.__capsuleDemo) return;
    window.__capsuleDemo = true;
    var tour = 0;
    function lancer() {
      var host = document.querySelector('.bca');
      if (!host) return;
      var moi = ++tour, LINES = JSON.parse(host.getAttribute('data-lignes') || '[]'), body = host.querySelector('.bca-body');
      var vivant = function () { return moi === tour && document.body.contains(body); };
      function mk(cls) { var d = document.createElement('div'); d.className = 'bca-ln bca-' + cls; return d; }
      function invite(d, txt) { var m = document.createElement('span'); m.className = 'bca-m'; m.textContent = txt.slice(0, 1) + ' '; d.appendChild(m); }
      body.innerHTML = '';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        LINES.forEach(function (l) { var d = mk(l[0]); if (l[0] == 'p') { invite(d, l[1]); d.appendChild(document.createTextNode(l[1].slice(2))); } else d.textContent = l[1]; d.classList.add('bca-on'); body.appendChild(d); });
        return;
      }
      var li = 0;
      function suite() {
        if (!vivant()) return;
        if (li >= LINES.length) {
          setTimeout(function () { if (!vivant()) return; body.style.transition = 'opacity .4s'; body.style.opacity = '0';
            setTimeout(function () { if (!vivant()) return; body.innerHTML = ''; body.style.opacity = '1'; li = 0; suite(); }, 450); }, 3400);
          return;
        }
        var l = LINES[li], d = mk(l[0]); body.appendChild(d);
        requestAnimationFrame(function () { d.classList.add('bca-on'); });
        if (l[0] == 'p') {
          var txt = l[1], i = 0; invite(d, txt);
          var tn = document.createTextNode(''); d.appendChild(tn);
          var cur = document.createElement('span'); cur.className = 'bca-cur'; d.appendChild(cur);
          (function tick() { if (!vivant()) return; i++; tn.textContent = txt.slice(2, 2 + i);
            if (i < txt.length - 2) setTimeout(tick, 26); else { cur.remove(); li++; setTimeout(suite, 340); } })();
        } else { d.textContent = l[1]; li++; setTimeout(suite, l[0] == 'ok' ? 200 : 260); }
      }
      suite();
    }
    document.addEventListener('astro:page-load', lancer);
    if (document.readyState !== 'loading') lancer();
  })();
</script>



<style is:global>
  /* Bandeau devis en fin de page formation : même dégradé d'entrée que les autres blocs. */
  main.bc > section.ctab { padding-top: 0; }
  main.bc > section.ctab::before {
    content: ''; display: block; height: clamp(84px, 11vw, 150px); margin: 0 -20px clamp(30px, 4vw, 56px);
    background: linear-gradient(180deg, #f6f8ef, #ffe897);
    background: linear-gradient(180deg in oklab, #f6f8ef 0%, #ffe897 92%);
  }
  /* Démonstration animée du haut de page */
  .bca { max-width: 580px; margin: 38px auto 0; text-align: left; background: #1c1712; border-radius: 16px; overflow: hidden; box-shadow: 0 26px 44px -22px rgba(0, 0, 0, .55); }
  .bca-bar { display: flex; align-items: center; gap: 7px; padding: 10px 14px; background: #2a231c; }
  .bca-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .bca-dot:nth-child(1) { background: #ff5f57; } .bca-dot:nth-child(2) { background: #febc2e; } .bca-dot:nth-child(3) { background: #28c840; }
  .bca-title { flex: 1; margin-left: 6px; color: #a89f91; font: 12px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .bca-logo { display: flex; align-items: center; }
  .bca-body { padding: 16px 18px 18px; font: 13.5px/1.75 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: #e8e2d5; min-height: 11.6em; }
  .bca-ln { white-space: pre-wrap; word-break: break-word; opacity: 0; transition: opacity .25s; }
  .bca-ln.bca-on { opacity: 1; }
  .bca-p { color: #fff; } .bca-p .bca-m { color: var(--bca-a); font-weight: 700; }
  .bca-o { color: #8b8272; } .bca-s { color: var(--bca-a); } .bca-ok { color: #7ee787; font-weight: 700; }
  .bca-cur { display: inline-block; width: 8px; height: 1em; margin-left: 2px; vertical-align: -.15em; background: var(--bca-a); animation: bca-bl 1s steps(1) infinite; }
  @keyframes bca-bl { 50% { opacity: 0; } }
  @media (max-width: 640px) { .bca { margin-top: 30px; } .bca-body { font-size: 12px; padding: 14px 14px 16px; } }
  @media (prefers-reduced-motion: reduce) { .bca-cur { animation: none; } .bca-ln { transition: none; } }
</style>
