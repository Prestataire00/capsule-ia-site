---
// Bandeau « Bootcamps & IA Expert » de l'accueil : quatre cartes uniformes,
// dont deux « Coup de cœur ». Textes validés par Faouzi (accueil refondu).
const cartes = [
  { href: '/bootcamp-claude/', tag: '16 h', titre: 'Bootcamp Claude de A à Z', coeur: true,
    texte: "Mode agentique, Claude Code, création d'agents et montage vidéo automatisé : tout l'univers de Claude en 16 heures de pratique." },
  { href: '/cerveau-ia/', tag: '16 h · IA Expert', titre: 'Cerveau IA : concevoir le vôtre', coeur: true,
    texte: "Cartographie des processus, base de connaissances, agents connectés et gouvernance : concevez le système qui s'occupe de ce qui se répète." },
  { href: '/bootcamp-chatgpt/', tag: '16 h', titre: 'Bootcamp ChatGPT de A à Z',
    texte: "Prompts, projets, GPT personnalisés, mode agent, Codex et automatisation : tout l'univers de ChatGPT en 16 heures de pratique." },
  { href: '/bootcamp-copilot/', tag: '16 h', titre: 'Bootcamp Copilot de A à Z',
    texte: "Copilot dans Word, Excel, PowerPoint, Outlook et Teams, agents et Copilot Studio : tout l'univers de Microsoft 365 Copilot en 16 heures de pratique." },
];
---

<section class="bcs" id="bootcamps" aria-labelledby="bcs-titre">
  <div class="bcs-in">
    <p class="bcs-eyebrow">Nouveau · Bootcamps &amp; IA Expert</p>
    <h2 id="bcs-titre">Maîtrisez un assistant IA <span>de A à Z.</span></h2>
    <p class="bcs-lead">Un parcours intensif de 16 heures : de la première demande jusqu'à l'agent connecté à vos outils.</p>
    <ul class="bcs-liste">
      {cartes.map((c) => (
        <li class={c.coeur ? 'bcs-star' : undefined}>
          {c.coeur && (
            <p class="bcs-une">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              Coup de cœur
            </p>
          )}
          <a href={c.href}>
            <p class="bcs-tag">{c.tag}</p>
            <h3>{c.titre}</h3>
            <p>{c.texte}</p>
            <span>Voir le programme →</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="bcs-note">Le même parcours s'adapte à Gemini ou Mistral : <a href="/devis/">parlons-en</a>.</p>
  </div>
</section>

<style>
  .bcs { background: #fff8ed; padding: clamp(52px, 7vw, 100px) 20px; text-align: center; font-family: 'Poppins', sans-serif; color: #1c1712; }
  .bcs-in { max-width: 980px; margin: 0 auto; }
  .bcs-eyebrow { margin: 0 0 16px; font: 700 12px/1 'Poppins', sans-serif; letter-spacing: .5em; text-transform: uppercase; color: #c40d60; }
  h2 { margin: 0; font: 700 clamp(32px, 4.6vw, 60px)/.98 'Inter Variable', Inter, sans-serif; letter-spacing: -.049em; text-wrap: balance; }
  h2 span { background: rgba(102, 209, 218, .5); padding: 0 .12em; white-space: nowrap; }
  .bcs-lead { margin: 20px auto 0; max-width: 56ch; font-size: clamp(14px, 1.3vw, 17px); line-height: 1.55; }
  .bcs-liste { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 22px; text-align: left; }
  .bcs-liste li.bcs-star { position: relative; }
  .bcs-une { position: absolute; top: 16px; right: 20px; z-index: 2; margin: 0; display: flex; align-items: center; gap: 6px; font: italic 700 11px/1 Poppins, sans-serif; letter-spacing: .02em; }
  li.bcs-star:nth-child(odd) .bcs-une { color: #1c1712; }
  li.bcs-star:nth-child(even) .bcs-une { color: #c40d60; }
  @media (max-width: 720px) { .bcs-liste { grid-template-columns: 1fr; } .bcs-eyebrow { letter-spacing: .14em; font-size: 11px; } }
  .bcs-liste a { display: flex; flex-direction: column; gap: 10px; height: 100%; background: #c40d60; color: #fff; border-radius: 32px; padding: 30px; box-shadow: 0 20px 30px -16px rgba(0, 0, 0, .45); transition: translate .35s cubic-bezier(.2, .7, .2, 1), box-shadow .35s; }
  .bcs-liste li:nth-child(even) a { background: #1c1712; }
  .bcs-liste a:hover { translate: 0 -8px; box-shadow: 0 30px 40px -18px rgba(0, 0, 0, .5); }
  .bcs-tag { margin: 0; align-self: flex-start; background: #ffe897; color: #1c1712; padding: 5px 14px; border-radius: 99px; font-size: 12px; font-weight: 700; }
  h3 { margin: 4px 0 0; font: 700 clamp(24px, 2.6vw, 32px)/1.05 'Inter Variable', Inter, sans-serif; letter-spacing: -.04em; }
  .bcs-liste a > p:not(.bcs-tag) { margin: 0; font-size: 14.5px; line-height: 1.55; opacity: .92; }
  .bcs-liste span { margin-top: auto; padding-top: 10px; font-weight: 700; font-style: italic; color: #ffe897; }
  .bcs-note { margin: 26px 0 0; font-size: 14.5px; }
  .bcs-note a { color: #c40d60; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
</style>
