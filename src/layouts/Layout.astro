---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/400-italic.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/700-italic.css';
import '@fontsource/poppins/800.css';
import '@fontsource/poppins/900.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Données structurées propres à la page (schema.org). */
  schema?: Record<string, unknown>[];
  /** Nom court de la page pour le fil d'Ariane. */
  fil?: string;
  noindex?: boolean;
}
const { title, description, schema = [], fil, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/partage.jpg', Astro.site);
const surDevis = Astro.url.pathname.startsWith('/devis');

const organisme = {
  '@type': 'EducationalOrganization',
  '@id': new URL('/#organisme', Astro.site),
  name: 'Capsule IA',
  url: Astro.site,
  logo: new URL('/favicon.png', Astro.site),
  description:
    "Organisme de formation à l'intelligence artificielle certifié Qualiopi : acculturation IA, IA & métiers, RGPD & réglementation, vibe coding.",
  email: 'contact@capsuleia.fr',
  telephone: '+33621005894',
  address: { '@type': 'PostalAddress', addressLocality: 'Orléans', addressRegion: 'Centre-Val de Loire', addressCountry: 'FR' },
  sameAs: ['https://www.instagram.com/capsuleai.fr/', 'https://www.linkedin.com/company/108125643/'],
  areaServed: [{ '@type': 'City', name: 'Orléans' }, { '@type': 'AdministrativeArea', name: 'Loiret' }, { '@type': 'Country', name: 'France' }],
  knowsAbout: ['Intelligence artificielle', 'IA générative', 'Rédaction de prompts', 'RGPD', 'AI Act', 'Vibe coding'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Demande de devis',
    telephone: '+33621005894',
    email: 'contact@capsuleia.fr',
    availableLanguage: 'French',
    url: new URL('/devis/', Astro.site),
  },
};
const siteWeb = {
  '@type': 'WebSite',
  '@id': new URL('/#site', Astro.site),
  name: 'Capsule IA',
  url: Astro.site,
  inLanguage: 'fr-FR',
  publisher: { '@id': organisme['@id'] },
};
const filAriane = fil && {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: Astro.site },
    { '@type': 'ListItem', position: 2, name: fil, item: canonical },
  ],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organisme, siteWeb, ...(filAriane ? [filAriane] : []), ...schema],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#c40d60" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Capsule IA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Capsule IA, formations à l'intelligence artificielle" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot />
    {
      !surDevis && (
        <a class="cta-flottant" href="/devis/" aria-label="Parlons de votre besoin : devis garanti sous 2 heures">
          <span class="cta-flottant-pastille">2 h</span>
          <span class="cta-flottant-texte">
            <b>Parlons de votre besoin</b>
            <small>Devis garanti sous 2 h</small>
          </span>
        </a>
      )
    }
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
